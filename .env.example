# Conexión de sólo lectura a la base de datos local.
# Se recomienda un usuario con permisos únicamente de SELECT.
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/bcb?schema=public"

# Backend NestJS local (BCB_EstrellaRoja_Backend). Sólo /importar lo usa, para
# reenviar los CSV a sus endpoints /seeds/* — sin auth, pensados para correr local.
SEEDS_API_URL="http://localhost:3000"
