  originTransactionId String             @unique
  originTransaction   LoyaltyTransaction @relation("BucketOrigin", fields: [originTransactionId], references: [id])

  initialAmount   Int // Ej: 100
  remainingAmount Int // Ej: 50 (se va reduciendo conforme se usan)

  expirationDate DateTime
  status         LoyaltyBucketStatus @default(ACTIVE)

