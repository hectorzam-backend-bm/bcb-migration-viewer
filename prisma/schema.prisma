model AdminsDepartment {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  roles  AdminDepartmentRole[]
  admins Admin[]
}

model AdminDepartmentRole {
  id                    String  @id @default(uuid())
  name                  String  @unique
  slug                  String  @unique
  allowMultipleStations Boolean @default(true)

  departmentId String
  department   AdminsDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  permissions AdminDepartmentRolePermission[]
  users       Admin[]
}

model Module {
  id                        String       @id @default(uuid())
  name                      String       @unique
  slug                      String       @unique
  resources                 String[]     @default([])
  allowedAccesses           AccessType[] @default([])
