generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  runtime         = "nodejs"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Service {
  id                 String    @id @default(uuid())
  number             String
  key                String    @unique
  shortName          String    @unique
  fullName           String    @unique
  account            String?   @unique
  isActive           Boolean   @default(true)
  allowEarlyDispatch Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Meramente informativo — sin efecto en el funcionamiento del sistema. Lo escribe solo el sync
  // HCM (services-hcm-sync.service.ts): true cuando GER retorna ESTATUS="N" o cuando el servicio
  // deja de venir en el reporte. hcmLastSeenRunId es el runId de la última corrida que lo trajo
  // (o que lo omitió por un conflicto, sin marcarlo ausente); permite detectar ausencias sin
  // estado en memoria y distingue servicios gestionados por HCM (!= null) de los creados a mano
  // por CRUD (null), que nunca deben marcarse. Mismo patrón que Company.hcmDisabled.
  hcmDisabled      Boolean @default(false)
  hcmLastSeenRunId String?

  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  createdById String?
  createdBy   Admin?  @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("ServiceUpdatedBy", fields: [updatedById], references: [id])

  stations           Station[]
  routes             Route[]
  amenities          Amenity[]
  units              Unit[]
  advanceSales       AdvanceSale[]
  ticketFormats      TicketFormat[]
  buses              Bus[]
  passengerTypes     PassengerType[]     @relation("ServicePassengerTypes")
  promotions         Promotion[]
  operators          Operator[]
  couponCampaigns    CouponCampaign[]    @relation("CouponCampaignServices")
  agencyRfcs         AgencyRfcService[]
  fikFocSchemeRoutes FikFocSchemeRoute[]

  @@index([deletedAt])
}

model Company {
  id        String    @id @default(uuid())
  key       String    @unique
  shortName String    @unique
  tradeName String    @unique
  legalName String    @unique
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Meramente informativo — sin efecto en el funcionamiento del sistema. Lo escribe solo el sync
  // HCM (companies-hcm-sync.service.ts): true cuando GER retorna ESTATUS="N" o cuando la empresa
  // deja de venir en el reporte. hcmLastSeenRunId es el runId de la última corrida que la trajo;
  // permite detectar ausencias sin estado en memoria y distingue empresas gestionadas por HCM
  // (!= null) de las creadas a mano por CRUD (null), que nunca deben marcarse.
  hcmDisabled      Boolean @default(false)
  hcmLastSeenRunId String?

  createdById String?
  createdBy   Admin?  @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("CompanyUpdatedBy", fields: [updatedById], references: [id])

  services                    Service[]
  cashRegisters               CashRegister[]
  miscellaneousProductCompany MiscellaneousProductCompany[]
  couponCampaigns             CouponCampaign[]
  miscellaneousSales          MiscellaneousSale[]
  agencies                    Agency[]

  @@index([deletedAt])
}

model Station {
  id        String      @id @default(uuid())
  shortName String      @unique
  name      String      @unique
  number    String      @unique
  address   String?
  latitude  Float
  longitude Float
  googleUrl String?
  phone     String?
  type      StationType
  isActive  Boolean     @default(true)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  stateId              String
  state                State   @relation(fields: [stateId], references: [id])
  facadePhotoFileId    String? @unique
  facadePhoto          File?   @relation("FacadePhoto", fields: [facadePhotoFileId], references: [id])
  isometricPhotoFileId String? @unique
  isometricPhoto       File?   @relation("IsometricPhoto", fields: [isometricPhotoFileId], references: [id])

  createdById String?
  createdBy   Admin?  @relation("StationCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("StationUpdatedBy", fields: [updatedById], references: [id])

  services                    Service[]
  originRoutes                Route[]                       @relation("RouteOrigin")
  destinationRoutes           Route[]                       @relation("RouteDestination")
  segmentsOrigin              Segment[]                     @relation("SegmentOrigin")
  segmentsDestination         Segment[]                     @relation("SegmentDestination")
  cashRegisters               CashRegister[]
  cashRegisterShifts          CashRegisterShift[]
  advisors                    AdvisorUser[]
  activeDonations             DonationActivation[]
  operators                   Operator[]
  buses                       Bus[]
  miscellaneousProductStation MiscellaneousProductStation[]
  miscellaneousSales          MiscellaneousSale[]
  prepaidCardSales            PrepaidCardSale[]
  prepaidCardRecharges        PrepaidCardRecharge[]
  admins                      Admin[]
  collectorShifts             CollectorShift[]
  advisorBalances             AdvisorStationBalance[]

  @@index([deletedAt])
}

enum StationType {
  SALE
  SCALE
}

model DonationActivation {
  id        String   @id @default(uuid())
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stations Station[]
}

model State {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stations Station[]
}

model Route {
  id                String         @id @default(uuid())
  number            String         @unique
  name              String         @unique
  collectionType    CollectionType
  priceOneWay       Decimal        @db.Decimal(10, 2)
  priceRound        Decimal?       @db.Decimal(10, 2)
  travelTimeMinutes Int // Tiempo de viaje en minutos
  distanceKm        Float // Distancia en kilómetros
  stayTimeMinutes   Int // Tiempo de estancia en minutos
  appliedIVA        Boolean        @default(false) // Indica si se aplica IVA
  hasSeatsSelection Boolean        @default(true)
  isActive          Boolean        @default(true)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  originId      String
  origin        Station @relation("RouteOrigin", fields: [originId], references: [id])
  destinationId String
  destination   Station @relation("RouteDestination", fields: [destinationId], references: [id])
  serviceId     String
  service       Service @relation(fields: [serviceId], references: [id])
  unitId        String?
  unit          Unit?   @relation(fields: [unitId], references: [id])

  fikFocSchemeId String?
  fikFocScheme   FikFocScheme? @relation(fields: [fikFocSchemeId], references: [id])

  // --- TomTom / InRoute ---
  tomTomInstruccionViajeId Int? @unique // nInstruccionViaje en InRoute

  createdById String?
  createdBy   Admin?  @relation("RouteCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("RouteUpdatedBy", fields: [updatedById], references: [id])

  segments           Segment[]
  salesChannels      RouteSalesChannel[]
  passengerTypes     RoutePassengerType[]
  trips              Trip[]
  stops              CourtesyStop[]
  tripsXlsxTemplates TripTemplate[]
  promotions         Promotion[]
  advanceSales       AdvanceSale[]
  couponCampaigns    CouponCampaign[]
  orderItems         OrderItem[]
  fikFocSchemeRoutes FikFocSchemeRoute[]

  @@index([deletedAt])
}

enum CollectionType {
  AUTOMATIC
  NORMAL
}

model Segment {
  id              String   @id @default(uuid())
  number          String
  stayTimeMinutes Int // Tiempo de estancia en minutos
  durationMinutes Int      @default(0) // Tiempo de viaje del tramo
  distanceKm      Float?
  allowSale       Boolean  @default(true) // Proximo a eliminarse
  isActive        Boolean  @default(true)
  isMain          Boolean  @default(false) // Tramo principal (origen-destino de la ruta)
  priceOneWay     Decimal  @db.Decimal(10, 2) // Tarifa sencilla
  priceRound      Decimal? @db.Decimal(10, 2) // Tarifa redonda (opcional)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  originStationId      String
  originStation        Station @relation("SegmentOrigin", fields: [originStationId], references: [id])
  destinationStationId String
  destinationStation   Station @relation("SegmentDestination", fields: [destinationStationId], references: [id])
  routeId              String
  route                Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  passengerTypes SegmentPassengerType[]
  stops          CourtesyStop[]
  salesChannels  SegmentSalesChannel[]
  orderItems     OrderItem[]

  deletedAt    DateTime?
  tripSegments TripSegment[]

  @@unique([routeId, number])
  @@unique([routeId, isMain], where: { isMain: true, deletedAt: null })
  @@index([deletedAt])
}

model SalesChannel {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  routes                   RouteSalesChannel[]
  passengerTypes           PassengerType[]
  promotions               Promotion[]
  advanceSales             AdvanceSale[]
  couponCampaigns          CouponCampaign[]
  segments                 SegmentSalesChannel[]
  orderItemStatusHistories OrderItemStatusHistory[]
  orders                   Order[]
  invoiceCodes             InvoiceCode[]

  @@index([deletedAt])
}

model RouteSalesChannel {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeId        String
  route          Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  salesChannelId String
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)

  @@id([routeId, salesChannelId])
}

model SegmentSalesChannel {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segmentId      String
  segment        Segment      @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  salesChannelId String
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)

  @@id([segmentId, salesChannelId])
}

model PassengerType {
  id                 String      @id @default(uuid())
  number             Int         @unique @default(autoincrement())
  order              Int?
  key                String      @unique
  name               String      @unique
  description        String?
  requiredDocument   Boolean     @default(false)
  documentType       String?
  isActive           Boolean     @default(true)
  discountPercent    Int         @default(0)
  seatingLimit       Int?
  allowedTicketTypes OrderType[] @default([ONE_WAY, ROUND, OPEN, OPEN_ROUND])
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  fileId String @unique
  icon   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   Admin?  @relation("PassengerTypeCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("PassengerTypeUpdatedBy", fields: [updatedById], references: [id])

  routes        RoutePassengerType[]
  trips         TripPassengerType[]
  salesChannels SalesChannel[]
  segments      SegmentPassengerType[]
  seats         TripSeat[]
  passengers    Passenger[]

  services                  Service[]                  @relation("ServicePassengerTypes")
  tripSegmentPassengerTypes TripSegmentPassengerType[]
  purchaseCouponCampaigns   CouponCampaign[]           @relation("CouponCampaignPurchasePassengerType")
  deliveryCouponCampaigns   CouponCampaign[]           @relation("CouponCampaignDeliveryPassengerType")

  @@index([deletedAt])
}

model RoutePassengerType {
  seatingLimit Int? // Null cuando no hay límite
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  routeId         String
  route           Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  passengerTypeId String
  passengerType   PassengerType @relation(fields: [passengerTypeId], references: [id], onDelete: Cascade)

  @@id([routeId, passengerTypeId])
}

model SegmentPassengerType {
  seatingLimit Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  segmentId       String
  segment         Segment       @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  passengerTypeId String
  passengerType   PassengerType @relation(fields: [passengerTypeId], references: [id], onDelete: Cascade)

  @@id([segmentId, passengerTypeId])
}

model CourtesyStop {
  id        String   @id @default(uuid())
  name      String
  order     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeId   String?
  route     Route?   @relation(fields: [routeId], references: [id])
  segment   Segment? @relation(fields: [segmentId], references: [id])
  segmentId String?
}

model File {
  id        String   @id @default(uuid())
  name      String
  path      String
  url       String
  mimetype  String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  passenger             PassengerType?
  facadePhotoStation    Station?       @relation("FacadePhoto")
  isometricPhotoStation Station?       @relation("IsometricPhoto")
  amenityIcon           Amenity?
  unitDeck              UnitDeck?
  unitDeckVertical      UnitDeck?      @relation("UnitDeckVertical")
  ticketFormat          TicketFormat?  @relation("TicketFormatLogo")
}

model Amenity {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  iconFileId  String    @unique
  icon        File      @relation(fields: [iconFileId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String?
  createdBy   Admin?  @relation("AmenityCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("AmenityUpdatedBy", fields: [updatedById], references: [id])

  services Service[]
  units    Unit[]

  @@index([deletedAt])
}

model Unit {
  id           String    @id @default(uuid())
  name         String
  description  String?
  number       Int
  type         UnitType  @default(BUS)
  bathroomSide String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdById String?
  createdBy   Admin?  @relation("UnitCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("UnitUpdatedBy", fields: [updatedById], references: [id])

  services  Service[]
  amenities Amenity[]
  decks     UnitDeck[]
  routes    Route[]

  @@index([deletedAt])
}

model UnitDeck {
  id        String   @id @default(uuid())
  order     Int
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitId               String
  unit                 Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  layoutFileId         String  @unique
  layout               File    @relation(fields: [layoutFileId], references: [id], onDelete: Cascade)
  verticalLayoutFileId String? @unique
  verticalLayout       File?   @relation("UnitDeckVertical", fields: [verticalLayoutFileId], references: [id], onDelete: Cascade)

  @@unique([unitId, order])
}

enum UnitType {
  BUS
  MICROBUS
  VAN
}

enum TripStatus {
  OPEN
  CLOSED
  CANCELLED
  FINISHED
  DISPATCHED
  CONFIRMED
  CANCELLED_BY_GROUP
}

enum TripType {
  NORMAL
  EXTRA
}

model Trip {
  id              String     @id @default(uuid())
  departure       DateTime
  arrival         DateTime?
  openSale        Boolean    @default(true)
  priceOneWay     Decimal    @default(0.00) @db.Decimal(10, 2)
  priceRound      Decimal    @default(0.00) @db.Decimal(10, 2)
  realDepartureAt DateTime?
  realArrivalAt   DateTime?
  status          TripStatus @default(OPEN)
  type            TripType   @default(NORMAL)
  dispatchedAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id])
  busId      String?
  bus        Bus?      @relation(fields: [busId], references: [id])
  routeId    String
  route      Route     @relation(fields: [routeId], references: [id])

  travelCard   TravelCard?
  planning     TripPlanning?
  tripDispatch TripDispatch?

  passengers                TripPassengerType[]
  seats                     TripSeat[]
  segments                  TripSegment[]
  tripAdvanceSaleUsages     TripAdvanceSaleUsage[]
  orderItemsOffline         OrderItemOffline[]
  tripAdvanceSaleRuleUsages TripAdvanceSaleRuleUsage[]

  @@unique([routeId, departure], where: { deletedAt: null })
  @@index([routeId, departure])
  @@index([departure, status, openSale])
  @@index([deletedAt])
}

model TripPassengerType {
  isActive     Boolean @default(true)
  seatingLimit Int?
  ticketsSold  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId          String
  trip            Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passengerTypeId String
  passengerType   PassengerType @relation(fields: [passengerTypeId], references: [id], onDelete: Cascade)

  @@id([tripId, passengerTypeId])
}

model TripSegment {
  id          String   @id @default(uuid())
  tripId      String
  segmentId   String
  priceOneWay Decimal  @db.Decimal(10, 2)
  priceRound  Decimal? @db.Decimal(10, 2)
  departure   DateTime @default(now())
  arrival     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id])

  passengerTypes TripSegmentPassengerType[]
  tripSeats      TripSeat[]

  orderItemStatusHistories OrderItemStatusHistory[]

  @@unique([tripId, segmentId])
  @@index([segmentId])
  @@index([tripId])
}

model TripSegmentPassengerType {
  isActive     Boolean @default(true)
  seatingLimit Int?
  ticketsSold  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripSegmentId   String
  tripSegment     TripSegment   @relation(fields: [tripSegmentId], references: [id], onDelete: Cascade)
  passengerTypeId String
  passengerType   PassengerType @relation(fields: [passengerTypeId], references: [id], onDelete: Cascade)

  @@id([tripSegmentId, passengerTypeId])
}

model TripSeat {
  id              String     @id @default(uuid())
  status          SeatStatus @default(AVAILABLE)
  number          Int
  passengerTypeId String?
  lockedAt        DateTime?
  tripId          String
  // Tramo del apartado vigente (AVAILABLE -> HOLD). Se limpia al liberar
  // (HOLD -> AVAILABLE); un valor rancio en un asiento BOOKED es inofensivo
  // porque toda lectura de cupo filtra status: HOLD.
  tripSegmentId   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  trip          Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passengerType PassengerType?        @relation(fields: [passengerTypeId], references: [id])
  tripSegment   TripSegment?          @relation(fields: [tripSegmentId], references: [id], onDelete: SetNull)
  orderItems    OrderItem[]
  blockReasons  TripSeatBlockReason[]

  @@index([tripId, number])
  @@index([tripSegmentId, status])
}

model TripSeatBlockReason {
  id        String   @id @default(uuid())
  reason    String
  seatId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats TripSeat @relation(fields: [seatId], references: [id])
}

enum SeatStatus {
  AVAILABLE
  HOLD
  BLOCKED
  BOOKED
  CHECK_IN
}

model TravelCard {
  id           String           @id @default(uuid())
  number       String
  key          String?          @unique
  status       TravelCardStatus @default(OPEN)
  departure    DateTime
  tomTomFailed Boolean          @default(false)
  tomTomTripId Int?             @unique // nViaje en InRoute (se llena al sincronizar con éxito)

  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id])

  updatedById String?
  updatedBy   Admin?  @relation("TravelCardUpdatedBy", fields: [updatedById], references: [id])

  statusLogs    TravelCardStatusLog[]
  collection    TravelCardCollection?
  boardingSales BoardingSale[]
  tomTomSyncs   TravelCardTomTomSync[]
  tomTomData    TomTomTripData?
  reprints      TravelCardReprint[]

  confirmedAt DateTime?
  collectedAt DateTime?
  cancelledAt DateTime?

  operatorPaymentSchemeType FikFocSchemeType?
  operatorPaymentIndicator  Decimal?          @db.Decimal(10, 4)
  operatorPaymentFactor     Decimal?          @db.Decimal(10, 4)
  operatorPaymentBase       Decimal?          @db.Decimal(10, 2)
  operatorPaymentAmount     Decimal?          @db.Decimal(10, 2)

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  amountLines TravelCardAmountLine[]
}

model TravelCardReprint {
  id            String  @id @default(uuid())
  reprintNumber Int
  justification String? @db.VarChar(500)

  travelCardId String
  travelCard   TravelCard @relation(fields: [travelCardId], references: [id])

  reprintedById String
  reprintedBy   Admin  @relation("TravelCardReprintedBy", fields: [reprintedById], references: [id])

  reprintedAt DateTime @default(now())

  @@unique([travelCardId, reprintNumber])
  @@index([travelCardId])
}

model TravelCardCollection {
  id               String  @id @default(uuid())
  collectionNumber Int     @unique
  expectedAmount   Decimal @db.Decimal(14, 2) // Monto calculado por el sistema al momento de recaudar

  travelCardId String     @unique
  travelCard   TravelCard @relation(fields: [travelCardId], references: [id])

  collectedById String?
  collectedBy   Admin?  @relation("TravelCardCollectionCollectedBy", fields: [collectedById], references: [id])

  collectorShiftId String?
  collectorShift   CollectorShift? @relation(fields: [collectorShiftId], references: [id])

  createdAt DateTime @default(now())

  @@index([collectorShiftId])
}

model TravelCardAmountLine {
  id       String            @id @default(uuid())
  concept  CollectionConcept
  quantity Int
  amount   Decimal           @db.Decimal(14, 2)

  travelCardId String
  travelCard   TravelCard @relation(fields: [travelCardId], references: [id], onDelete: Cascade)

  @@unique([travelCardId, concept])
}

enum CollectionConcept {
  SYSTEM_SALES // Venta de sistema (Aquellos boletos que fueron escaneados por el operador pero no vendidos por el mismo)
  ONBOARD_SALES // Venta a bordo (Boletos vendidos por el operador)
  MANUAL_SALES // Venta manual (Ajustes en la recolección)
  PREPAID_TICKETS // Prepago: Boletos pagados mediante tarjeta de prepago
  PREPAID_RECHARGES // Prepago: Recargas a tarjetas de prepago
  PREPAID_SALES // Prepago: Ventas de tarjetas de prepago
  PENALTY // Penalización al momento de la recaudación
}

model TravelCardStatusLog {
  id             String           @id @default(uuid())
  previousStatus TravelCardStatus
  newStatus      TravelCardStatus
  justification  String?          @db.VarChar(250)

  travelCardId String
  travelCard   TravelCard @relation(fields: [travelCardId], references: [id])

  createdAt DateTime @default(now())
}

model CollectorShift {
  id          String               @id @default(uuid())
  corteNumber Int                  @unique
  period      CollectorShiftPeriod
  status      CollectorShiftStatus @default(OPEN)

  collectorId String
  collector   Admin  @relation("CollectorShiftCollector", fields: [collectorId], references: [id])

  stationId String
  station   Station @relation(fields: [stationId], references: [id])

  coordinatorId String?
  coordinator   Admin?  @relation("CollectorShiftCoordinator", fields: [coordinatorId], references: [id])

  lockedById    String?
  lockedBy      Admin?    @relation("CollectorShiftLockedBy", fields: [lockedById], references: [id])
  lockedAt      DateTime?
  lockExpiresAt DateTime?

  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  shiftEnd       DateTime?
  cutStartedAt   DateTime?
  cutCompletedAt DateTime?

  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation("CollectorShiftUpdatedBy", fields: [updatedById], references: [id])

  declaredCardCount Int?
  declaredAmount    Decimal? @db.Decimal(12, 2)
  actualCardCount   Int?
  actualAmount      Decimal? @db.Decimal(12, 2)
  cardCountDiff     Int?
  amountDiff        Decimal? @db.Decimal(12, 2)

  collections TravelCardCollection[]

  @@unique([collectorId, stationId], map: "CollectorShift_one_open_per_collector_station", where: { status: "OPEN" })
  @@index([collectorId])
  @@index([stationId])
  @@index([coordinatorId])
}

enum CollectorShiftPeriod {
  MORNING // 05:00–13:59
  AFTERNOON // 14:00–21:59
  NIGHT // 22:00–04:59
}

enum CollectorShiftStatus {
  OPEN
  IN_PROCESS
  RECONCILED
  RECONCILED_WITH_DIFFERENCE
}

enum TravelCardStatus {
  OPEN
  CONFIRMED
  COLLECTED
  CANCELLED
}

enum CashRegisterStatus {
  ACTIVE
  INACTIVE
  UNASSIGNED
}

// Tipos de corte de caja
enum CashRegisterShiftType {
  SHIFT // Corte por turno (individual)
  DAILY // Corte diario
  TERMINAL // Corte de terminal
  TICKET_OFFICE // Taquilla
  TICKET_OFFICE_OFFLINE // Ticket collector offline
}

// Estados del corte de caja
enum CashRegisterShiftStatus {
  OPEN // Turno activo, asesor trabajando
  IN_PROCESS // Coordinador realizando corte
  RECONCILED // Conciliado sin diferencias
  RECONCILED_WITH_DIFFERENCE // Conciliado con diferencias
}

model CashRegister {
  id                   String                   @id @default(uuid())
  name                 String                   @unique
  number               String
  deviceIdentifier     String                   @unique
  paymentTypes         PaymentType[]
  status               CashRegisterStatus       @default(INACTIVE)
  openingFloat         Decimal?                 @db.Decimal(14, 2)
  minCashLimit         Decimal?                 @db.Decimal(14, 2)
  maxCashLimit         Decimal?                 @db.Decimal(14, 2)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?
  device               CashRegisterDevice
  stationId            String
  station              Station                  @relation(fields: [stationId], references: [id])
  companies            Company[]
  createdById          String?
  createdBy            Admin?                   @relation("CashRegisterCreatedBy", fields: [createdById], references: [id])
  updatedById          String?
  updatedBy            Admin?                   @relation("CashRegisterUpdatedBy", fields: [updatedById], references: [id])
  activeAdvisorUserId  String?
  activeAdvisorUser    AdvisorUser?             @relation("CashRegisterActiveAdvisorUser", fields: [activeAdvisorUserId], references: [id], onDelete: SetNull)
  activeOperatorId     String?
  activeOperator       Operator?                @relation("CashRegisterActiveOperator", fields: [activeOperatorId], references: [id], onDelete: SetNull)
  miscellaneousSales   MiscellaneousSale[]
  orders               Order[]
  loyaltyWallets       LoyaltyWallet[]
  prepaidCardSales     PrepaidCardSale[]
  prepaidCardRecharges PrepaidCardRecharge[]
  ticketMovements      OrderItemStatusHistory[]

  @@unique([name, stationId])
  @@index([deletedAt])
}

enum CashRegisterDevice {
  TICKET_OFFICE
  TICKET_COLLECTOR_TPV
  TICKET_COLLECTOR_OFFLINE
  MOBILE_BOARDING
}

// Modelo de Corte de Caja (Shift)
model CashRegisterShift {
  id                String                  @id @default(uuid())
  shiftType         CashRegisterShiftType
  status            CashRegisterShiftStatus @default(OPEN)
  openingCashAmount Decimal                 @default(0) @db.Decimal(14, 2) // Monto inicial al abrir el turno

  // Indica si Ticket Collector Offline (TCO) ya sincronizó su venta en BCB
  isTCOSync Boolean @default(false)

  // Número secuencial del corte (por caja)
  shiftNumber Int

  advisorUserId String?
  advisorUser   AdvisorUser? @relation(fields: [advisorUserId], references: [id])

  stationId String
  station   Station @relation(fields: [stationId], references: [id])

  shiftStart     DateTime  @default(now())
  shiftEnd       DateTime?
  cutStartedAt   DateTime?
  cutCompletedAt DateTime?

  systemTotalCount  Int     @default(0)
  systemTotalAmount Decimal @default(0) @db.Decimal(14, 2)

  cashDifference  Decimal? @db.Decimal(14, 2)
  cardDifference  Decimal? @db.Decimal(14, 2)
  totalDifference Decimal? @db.Decimal(14, 2)

  notes            String? @db.Text
  discrepancyNotes String? @db.Text
  coordinatorNotes String? @db.Text

  // Auditoría
  coordinatorId String?
  coordinator   Admin?  @relation("ShiftCoordinator", fields: [coordinatorId], references: [id])
  createdById   String?
  createdBy     Admin?  @relation("ShiftCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     Admin?  @relation("ShiftUpdatedBy", fields: [updatedById], references: [id])

  lockedById    String?
  lockedBy      Admin?    @relation("ShiftLockedBy", fields: [lockedById], references: [id])
  lockedAt      DateTime? // Timestamp de cuando se bloqueó
  lockExpiresAt DateTime? // Expiración automática del bloqueo (ej: 5 minutos)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relaciones
  cashBreakdown        CashBreakdown?
  amountLines          ShiftAmountLine[]
  cashCollections      CashCollection[]
  orders               Order[]
  miscellaneousSales   MiscellaneousSale[]
  prepaidCardSales     PrepaidCardSale[]
  prepaidCardRecharges PrepaidCardRecharge[]
  ticketMovements      OrderItemStatusHistory[]

  @@index([advisorUserId])
  @@index([stationId])
  @@index([status])
  @@index([shiftStart])
  @@index([deletedAt])
}

// ─── ENUMS ───
enum ShiftPaymentMethod {
  CASH
  CARD
  OTHER
}

enum ShiftConcept {
  // Efectivo y Tarjeta
  TOTAL // Solo aplica a CASH y CARD (systemCashTotal*, systemCardTotal*)
  ONE_WAY_ROUND_TICKETS
  OPEN_TICKETS
  COUPON_TICKETS
  PROMO_TICKETS
  OPEN_REFERENCED_TICKETS
  REDEEMED_REFERENCED_TICKETS
  MISCELLANEOUS
  PREPAID_CARD_SALES
  PREPAID_CARD_RECHARGES
  CANCELLATIONS
  SURCHARGES
  REFUNDS
  PENALTIES

  // Otros (paymentMethod = OTHER)
  LOYALTY_PROGRAM
  TRAVEL_ORDERS
  TRANSFER_TICKETS
  COURTESIES
  REDEEMED_TICKETS
  REFERENCED_TICKETS
  SURPLUS
  SCHEDULE_CHANGES
}

// ─── MODELO NORMALIZADO ───
model ShiftAmountLine {
  id String @id @default(uuid())

  shiftId String
  shift   CashRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  paymentMethod ShiftPaymentMethod
  concept       ShiftConcept

  // Sistema (calculado automáticamente)
  systemCount  Int     @default(0)
  systemAmount Decimal @default(0) @db.Decimal(14, 2)

  // Declarado por el asesor/coordinador
  declaredCount  Int?
  declaredAmount Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cada combinación shift + método + concepto es única
  @@unique([shiftId, paymentMethod, concept])
  @@index([shiftId])
  @@index([paymentMethod, concept])
}

// Desglose de efectivo físico (billetes y monedas)
model CashBreakdown {
  id String @id @default(uuid())

  shiftId String            @unique
  shift   CashRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  // Billetes (cantidad de cada denominación)
  bills1000 Int @default(0)
  bills500  Int @default(0)
  bills200  Int @default(0)
  bills100  Int @default(0)
  bills50   Int @default(0)
  bills20   Int @default(0)

  // Monedas
  coins20  Int @default(0)
  coins10  Int @default(0)
  coins5   Int @default(0)
  coins2   Int @default(0)
  coins1   Int @default(0)
  coins050 Int @default(0) // $0.50

  // Total calculado
  totalAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Recolección de efectivo de caja
model CashCollection {
  id                  String  @id @default(uuid())
  amount              Decimal @db.Decimal(14, 2) // Monto recolectado
  isOpeningCashAmount Boolean @default(false) // true si es apertura de caja, false si es recolección normal

  shiftId String
  shift   CashRegisterShift @relation(fields: [shiftId], references: [id])

  createdById String?
  createdBy   Admin?  @relation("CashCollectionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([shiftId])
  @@index([deletedAt])
}

// Efectivo en mano del asesor, por estación. Todas las cajas de una misma
// estación comparten un solo saldo; cambiar de estación sí resetea a 0.
model AdvisorStationBalance {
  id          String  @id @default(uuid())
  currentCash Decimal @default(0) @db.Decimal(14, 2)

  advisorUserId String
  advisorUser   AdvisorUser @relation(fields: [advisorUserId], references: [id], onDelete: Cascade)
  stationId     String
  station       Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([advisorUserId, stationId])
  @@index([advisorUserId])
  @@index([stationId])
}

enum PaymentType {
  CASH
  CARD
  PAYMENT_WITH_POINTS
  PAYMENT_WITH_TRAVEL_ORDER
  TRANSFER_PASS
  COMPLIMENTARY
  EXCHANGE //Venta sistema: Aquellos que se escanearon.
  PREPAID //Boletos: Aquellos que pagas con prepago
  RELOAD //Recargas: Recarga de saldo en una tarjeta de prepago
