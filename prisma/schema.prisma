}

// ─── Portal de Nómina ─────────────────────────────────────────────────────────

enum PayrollBonusStatus {
  PENDING
  PROCESSED
}

enum ManualBonusType {
  PRODUCTIVITY
  FUEL
  QUALITY
  TRAVEL_EXPENSES
  PRIZE
  DISCOUNT
  OTHER
}

enum SpecialServiceType {
  TOURISM
  FREIGHT
  OTHER
}

model ManualBonus {
  id          String             @id @default(uuid())
  operatorId  String
  bonusType   ManualBonusType
  amount      Decimal            @db.Decimal(12, 2)
  periodStart DateTime           @db.Date
  periodEnd   DateTime           @db.Date
  comments    String?            @db.VarChar(255)
  status      PayrollBonusStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  operator  Operator @relation(fields: [operatorId], references: [id])
  createdBy Admin?   @relation("ManualBonusCreatedBy", fields: [createdById], references: [id])
  updatedBy Admin?   @relation("ManualBonusUpdatedBy", fields: [updatedById], references: [id])

  @@index([operatorId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([deletedAt])
}

model SpecialService {
  id          String             @id @default(uuid())
  operatorId  String
  serviceDate DateTime           @db.Date
  serviceType SpecialServiceType
  workedDays  Decimal            @db.Decimal(6, 2)
  fixedAmount Decimal?           @db.Decimal(12, 2)
  status      PayrollBonusStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  operator  Operator @relation(fields: [operatorId], references: [id])
  createdBy Admin?   @relation("SpecialServiceCreatedBy", fields: [createdById], references: [id])
  updatedBy Admin?   @relation("SpecialServiceUpdatedBy", fields: [updatedById], references: [id])

  @@index([operatorId])
  @@index([serviceDate])
  @@index([deletedAt])
}

model NonWorkingDay {
  id            String    @id @default(uuid())
  date          DateTime  @db.Date
  description   String    @db.VarChar(100)
  paymentFactor Decimal   @db.Decimal(6, 4)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?

  createdBy Admin? @relation("NonWorkingDayCreatedBy", fields: [createdById], references: [id])
  updatedBy Admin? @relation("NonWorkingDayUpdatedBy", fields: [updatedById], references: [id])

  @@unique([date], map: "NonWorkingDay_date_active_key", where: { deletedAt: null })
  @@index([date])
  @@index([deletedAt])
}

// ── Business Rules ─────────────────────────────────────

enum BusinessRuleAction {
  CANCEL
  CHANGE
  EXCHANGE
}

enum RuleKind {
  TIMING
  PENALTY
  ELIGIBILITY
}

enum PenaltyCalcType {
  PERCENT_OF_TOTAL
  FIXED_AMOUNT
}

enum SurchargeType {
  NORMAL
  PENALTY
}

model BusinessRule {
  id String @id @default(uuid())

  actionType  BusinessRuleAction
  kind        RuleKind
  name        String
  description String?

  allServices        Boolean         @default(false)
  serviceIds         String[]        @default([])
  excludedServiceIds String[]        @default([])
  routeIds           String[]        @default([])
  paymentMethods     PaymentMethod[] @default([])
  salesChannelIds    String[]        @default([])
  orderTypes         OrderType[]     @default([])

  minutesBeforeDeparture Int?
  minutesAfterDeparture  Int?

  penaltyCalcType               PenaltyCalcType?
  penaltyValue                  Decimal?         @db.Decimal(10, 2)
  penaltyTaxApplies             Boolean?
  triggerMinutesAfterDeparture  Int?
  triggerMinutesBeforeDeparture Int?

  maxDaysSincePurchase    Int?
  maxHoursSincePurchase   Int?
  minHoursBeforeDeparture Int?

  priority   Int       @default(100)
  enabled    Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([actionType, kind, enabled, priority])
}
