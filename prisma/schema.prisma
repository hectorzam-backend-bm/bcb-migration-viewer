  EXPIRED // Se venció el tiempo
}

model LoyaltyTransaction {
  id String @id @default(uuid())

  walletId String
  wallet   LoyaltyWallet @relation(fields: [walletId], references: [id])

  type   LoyaltyTransactionType
  amount Int // +100 (ganancia) o -150 (gasto)

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  description String?

  // Trazabilidad de ajustes: vincula esta transacción con la transacción original que se está ajustando
  relatedTransactionId String?
  relatedTransaction   LoyaltyTransaction?  @relation("TransactionAdjustment", fields: [relatedTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adjustments          LoyaltyTransaction[] @relation("TransactionAdjustment")

  // Metadata adicional para auditoría (ej: { previousPrice: 100, newPrice: 150, reason: "schedule_change" })
  metadata Json?

  createdAt DateTime @default(now())

  // Si fue ganancia, generó este bucket:
  generatedBucket LoyaltyPointBucket? @relation("BucketOrigin")

  // Si fue gasto, consumió de estos buckets:
  bucketUsages LoyaltyBucketUsage[]

  deletedAt   DateTime?
  createdById String?
  createdBy   Admin?    @relation("LoyaltyTransactionCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?    @relation("LoyaltyTransactionUpdatedBy", fields: [updatedById], references: [id])

  @@index([orderItemId])
  @@index([relatedTransactionId])
}

model LoyaltyBucketUsage {
  id String @id @default(uuid())

  transactionId String
  transaction   LoyaltyTransaction @relation(fields: [transactionId], references: [id])

  bucketId String
  bucket   LoyaltyPointBucket @relation(fields: [bucketId], references: [id])

  amountUsed Int // Cuántos puntos se tomaron de ESTE bucket específico

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  createdById String?
  createdBy   Admin?    @relation("LoyaltyBucketUsageCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?    @relation("LoyaltyBucketUsageUpdatedBy", fields: [updatedById], references: [id])
}

enum LoyaltyTransactionType {
  EARNED // Compra normal o promo
  REDEEMED // Uso de puntos
  EXPIRED // Vencimiento
  ADJUSTMENT // Corrección manual
  REFUND_EARNED // Se canceló la compra que dio puntos (restar)
  REFUND_REDEEMED // Se canceló la compra pagada con puntos (devolver)
}

