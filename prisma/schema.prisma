  service        LoyaltyServiceType
  loyalityBanner LoyalityBanner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  createdById String?
  createdBy   Admin?    @relation("LoyalityBannerByServiceCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?    @relation("LoyalityBannerByServiceUpdatedBy", fields: [updatedById], references: [id])
