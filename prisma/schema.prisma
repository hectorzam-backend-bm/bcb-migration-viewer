enum FikFocSchemeType {
  FIK
  FOC
}

model FikFocScheme {
  id        String           @id @default(uuid())
  type      FikFocSchemeType
  costByKm  Decimal          @db.Decimal(10, 4)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  deletedAt   DateTime?
  createdById String?
  createdBy   Admin?    @relation("FikFocSchemeCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?    @relation("FikFocSchemeUpdatedBy", fields: [updatedById], references: [id])

  ranges       FikFocRange[]
  routes       Route[]
  schemeRoutes FikFocSchemeRoute[]

  @@index([deletedAt])
}

model FikFocRange {
  id               String   @id @default(uuid())
  rangeMin         Decimal  @db.Decimal(10, 4)
  rangeMax         Decimal  @db.Decimal(10, 4)
  applicableFactor Decimal  @db.Decimal(10, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deletedAt DateTime?

  schemeId String
  scheme   FikFocScheme @relation(fields: [schemeId], references: [id])

  createdById String?
  createdBy   Admin?  @relation("FikFocRangeCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("FikFocRangeUpdatedBy", fields: [updatedById], references: [id])

  schemeRoutes FikFocSchemeRoute[]

  @@index([schemeId])
  @@index([deletedAt])
}

model FikFocSchemeRoute {
  id String @id @default(uuid())

  // Snapshot at assignment time
  routeNumber          String
  description          String // "Origin → Destination"
  commercialDistanceKm Decimal @db.Decimal(10, 4)
  ratePerKm            Decimal @db.Decimal(10, 4) // reference field (PM requirement)

  // Computed values
  fareAmount         Decimal @db.Decimal(10, 4) // commercialDistanceKm × ratePerKm
  adjustedFareAmount Decimal @db.Decimal(10, 4) // commercialDistanceKm × applicableFactor

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  schemeId String
  scheme   FikFocScheme @relation(fields: [schemeId], references: [id])

  routeId String
  route   Route  @relation(fields: [routeId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  fikFocRangeId String
  fikFocRange   FikFocRange @relation(fields: [fikFocRangeId], references: [id])

  createdById String?
  createdBy   Admin?  @relation("FikFocSchemeRouteCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("FikFocSchemeRouteUpdatedBy", fields: [updatedById], references: [id])

  @@unique([schemeId, routeId])
  @@index([schemeId])
  @@index([deletedAt])
}

// ─── Portal de Agencias ───────────────────────────────────────────────────────

enum AgencyStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model Agency {
  id              String       @id @default(uuid())
  name            String       @db.VarChar(100)
  status          AgencyStatus @default(ACTIVE)
  creditLimit     Decimal      @default(0) @db.Decimal(10, 2)
  currentDebt     Decimal      @default(0) @db.Decimal(10, 2)
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  passwordHash    String
  isTempPassword  Boolean      @default(true)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String?
  createdBy   Admin?  @relation("AgencyCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("AgencyUpdatedBy", fields: [updatedById], references: [id])

  rfcs     AgencyRfc[]
  sessions AgencySession[]
  payments AgencyPayment[]
  charges  AgencyCharge[]
  cortes   AgencyCorte[]

  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model AgencyRfc {
  id           String   @id @default(uuid())
  rfc          String   @unique @db.VarChar(13)
  businessName String
  email        String   @unique
  phone        String   @db.VarChar(10)
  address      String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  agencyId String
  agency   Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  services AgencyRfcService[]

  @@index([agencyId])
}

model AgencyRfcService {
  agencyRfcId String
  agencyRfc   AgencyRfc @relation(fields: [agencyRfcId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([agencyRfcId, serviceId])
}

model AgencySession {
  id           String   @id @default(uuid())
  accessToken  String   @unique
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model AgencyPayment {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2)
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  registeredById String?
  registeredBy   Admin?  @relation("AgencyPaymentRegisteredBy", fields: [registeredById], references: [id])

  @@index([agencyId])
}

model AgencyCharge {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  registeredById String?
  registeredBy   Admin?  @relation("AgencyChargeRegisteredBy", fields: [registeredById], references: [id])

  updatedById String?
  updatedBy   Admin?  @relation("AgencyChargeUpdatedBy", fields: [updatedById], references: [id])

  corteId String?
  corte   AgencyCorte? @relation(fields: [corteId], references: [id])

  @@index([agencyId, createdAt])
  @@index([corteId])
}

model AgencyCorte {
  id             String   @id @default(uuid())
  from           DateTime
  to             DateTime
  totalTickets   Int      @default(0)
  grossAmount    Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  netAmount      Decimal  @default(0) @db.Decimal(12, 2)
  pdfUrl         String?
  createdAt      DateTime @default(now())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  createdById String?
  createdBy   Admin?  @relation("AgencyCorteCreatedBy", fields: [createdById], references: [id])

  charges AgencyCharge[]

  @@index([agencyId, from, to])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  snapshot   Json?
  createdAt  DateTime @default(now())

  performedById String?
  performedBy   Admin?  @relation("AuditLogPerformedBy", fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([performedById])
}

model TomTomGroup {
  id            String  @id @default(uuid())
  tomTomGroupId Int     @unique // nGrupo en InRoute
  name          String?

  buses     Bus[]
  operators Operator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TravelCardTomTomSync {
  id           String     @id @default(uuid())
  travelCardId String
  travelCard   TravelCard @relation(fields: [travelCardId], references: [id])

  operation    TomTomSyncOperation
  status       TomTomSyncStatus
  tomTomTripId Int? // nViaje generado (solo en CREATE exitoso)
  errorMessage String?

  attemptedAt DateTime @default(now())

  @@index([travelCardId])
}

// Operational data of a finished trip in InRoute.
// Populated by BIGER when nStatusViaje = 6 (Terminated).
// Stored in BCB to decouple collection and variable bonus processes
// from InRoute availability.
model TomTomTripData {
  id           String     @id @default(uuid())
  travelCardId String     @unique
  travelCard   TravelCard @relation(fields: [travelCardId], references: [id])

  // Trip status in InRoute at the time of sync
  tripStatus Int // nStatusViaje (1-7)

  // Planned vs real times
  departurePlanned DateTime? // cFechaSalidaPlaneada + cHoraSalidaPlaneada
  departureReal    DateTime? // cFechaSalidaReal + cHoraSalidaReal
  arrivalReal      DateTime? // cFechaLlegadaReal + cHoraLlegadaReal

  // Operational telemetry
  distanceKm        Float? // nDistanciaRecorrida (km)
  fuelLiters        Float? // nConsumoGasolina (litros)
  fuelEfficiencyKmL Float? // nRendimientoGasolina (km/litro)
  avgSpeedKmh       Float? // nVelocidadPromedio (km/h)
  maxSpeedKmh       Float? // nVelocidadMaxima (km/h)
  durationMinutes   Int? // nTiempoDuracion (minutos)
  stoppedMinutes    Int? // nTiempoParado (minutos)

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TomTomSyncOperation {
  CREATE
  UPDATE
  CANCEL
}

enum TomTomSyncStatus {
  SUCCESS
  FAILED
}

//Recollecion tecket collector offline

enum SyncOfflineRequestStatus {
  PROCESSING
  DONE
  FAILED
}

model OrderItemOffline {
  id                 String   @id @default(uuid())
  tabletTicketNumber String
  createdAt          DateTime @default(now())

  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tabletTicketNumber])
}

model SyncOfflineRequest {
  id               String                   @id
  syncId           String                   @unique
  advisorId        String?
  status           SyncOfflineRequestStatus @default(PROCESSING)
  payloadHash      String                   @db.Char(64)
  responseSnapshot Json?
  attempts         Int                      @default(1)
  errorMessage     String?
  receivedAt       DateTime                 @default(now())
  processedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime

  AdvisorUser             AdvisorUser?              @relation(fields: [advisorId], references: [id])
  SyncOfflineRequestOrder SyncOfflineRequestOrder[]

  @@index([advisorId])
  @@index([status])
  @@index([receivedAt])
}

model SyncOfflineRequestOrder {
  id                  String   @id
  syncRequestId       String
  orderId             String
  isCanceledInPayload Boolean  @default(false)
  createdAt           DateTime @default(now())

  SyncOfflineRequest SyncOfflineRequest @relation(fields: [syncRequestId], references: [id], onDelete: Cascade)
  Order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([syncRequestId, orderId])
  @@index([orderId])
}

