model Order {
  id String @id @default(uuid())

  // Relaciones padre
  clientId          String?
  client            Client?            @relation(fields: [clientId], references: [id])
  advisorId         String?
  Advisor           AdvisorUser?       @relation(fields: [advisorId], references: [id])
  surchargeOriginId String?
  surchargeOrigin   Order?             @relation("OrderSurchargeOrigin", fields: [surchargeOriginId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  orderItemOriginId String?
  salesChannelId    String?
  salesChannel      SalesChannel?      @relation(fields: [salesChannelId], references: [id])
  cashRegisterId    String?
  cashRegister      CashRegister?      @relation(fields: [cashRegisterId], references: [id])
  shiftId           String?
  shift             CashRegisterShift? @relation(fields: [shiftId], references: [id])

  type             OrderType
  surchargeType    SurchargeType @default(NORMAL)
  triggeringRuleId String?
  invoiceCode      String?
  isInvoiced       Boolean       @default(false)
  status           OrderStatus   @default(AWAITING_PAYMENT)
  paymentMethod    PaymentMethod @default(CASH)

  // Montos
  subtotal       Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  taxIVA         Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  moneyExchanged Decimal? @default(0) @db.Decimal(12, 2)
  cashReceived   Decimal? @db.Decimal(12, 2)

  // Referencias del proveedor
  provider          String? // 'stripe' | 'mpago' | 'conekta' | ...
  providerIntentId  String?
  providerPaymentId String?

  // Datos de contacto
  guestName  String?
  invoiceRfc String? // RFC para facturación de la venta (RFC_CLIENTE en reporte de agencias)
  email      String?
  phone      String?

  // Datos MIT
  mitTransactionDate     DateTime?
  mitTransactionNumber   String?
  mitAuthorizationNumber String?

  courtesyAuthorizerAdminId String?
  courtesyAuthorizerAdmin   Admin?  @relation("CourtesyAuthorizerAdmin", fields: [courtesyAuthorizerAdminId], references: [id])

  // Refund tracking (solo aplican cuando type=REFUND con paymentMethod=MIT)
  mitRefundId         String?
  refundedAt          DateTime?
  refundFailureReason String?

  // Snapshot de penalties calculadas en prepareRefund (CANCEL MIT) usadas en confirmRefund
  penaltiesSnapshot Json?

  // Pago con puntos de lealtad (Biger)
  loyaltyPointsUsed    Int? // puntos descontados del wallet del cliente
  bigerCorrelationId   String? @unique // ID de correlación enviado a Biger para vincular la redención
  bigerAuthorizationId String? // folio de autorización devuelto por Biger al confirmar el descuento

  // Fechas clave
  expiresAt DateTime?
  issuedAt  DateTime? // cuándo se “emitió” el boleto (opcional)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Indicadores rapidos
  hasPromotion   Boolean @default(false)
  hasAdvanceSale Boolean @default(false)
  hasCoupon      Boolean @default(false)

  surcharges               Order[]                   @relation("OrderSurchargeOrigin")
  items                    OrderItem[]
  OrderStatusHistory       OrderStatusHistory[]
  ticketMovementsSurcharge OrderItemStatusHistory[]  @relation("TicketMovementSurcharge")
  ticketMovementsRefund    OrderItemStatusHistory[]  @relation("TicketMovementRefund")
  ticketMovementsPenalty   OrderItemStatusHistory[]  @relation("TicketMovementPenalty")
  appliedPromotion         OrderPromotion?
  appliedAdvanceSale       OrderAdvanceSale?
  appliedCoupon            OrderCoupon?
  SyncOfflineRequestOrder  SyncOfflineRequestOrder[]
  pendingTicketMovement    PendingTicketMovement?

  @@unique([surchargeOriginId, orderItemOriginId, triggeringRuleId], map: "Order_penalty_idempotency", where: { type: "SURCHARGE", surchargeType: "PENALTY" })
  @@index([clientId])
  @@index([cashRegisterId])
  @@index([shiftId])
  @@index([expiresAt])
}

model PendingTicketMovement {
  id                 String   @id @default(uuid())
  orderId            String   @unique
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketId           String
  newSeatId          String
  newSegmentId       String?
  movementType       String
  advisorId          String
  salesChannelId     String
  cancellationReason String   @default("Cancelado por cambio")
  newBasePrice       Decimal  @db.Decimal(12, 2)
  newTax             Decimal  @db.Decimal(12, 2)
  newDiscount        Decimal  @db.Decimal(12, 2)
  newTotalPrice      Decimal  @db.Decimal(12, 2)
  surchargeAmount    Decimal  @db.Decimal(12, 2)
  penaltiesSnapshot  Json?
  createdAt          DateTime @default(now())

  @@index([orderId])
}

model PendingGroupMovement {
  id                 String   @id @default(uuid())
  originOrderId      String
  movementType       String
  advisorId          String
  salesChannelId     String
  cancellationReason String   @default("Cancelado por cambio")
  itemsSnapshot      Json
  totalAmount        Decimal  @db.Decimal(12, 2)
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([advisorId])
  @@index([expiresAt])
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  status      OrderStatus
  orderItemId String?
  changedById String?
  createdAt   DateTime    @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation("OrderItemHistory", fields: [orderItemId], references: [id])

  @@index([orderId])
}

model OrderPromotion {
  id           String      @id @default(uuid())
  orderId      String      @unique
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotionId  String?
  promotion    Promotion?  @relation(fields: [promotionId], references: [id])
  couponCodeId String?
  couponCode   CouponCode? @relation(fields: [couponCodeId], references: [id])

  promotionName  String
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  discountAmount Decimal      @db.Decimal(10, 2)
  originalPrice  Decimal      @db.Decimal(10, 2)
  ticketsApplied Int

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([promotionId])
}

model OrderAdvanceSale {
  id                String          @id @default(uuid())
  orderId           String          @unique
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  advanceSaleId     String
  advanceSale       AdvanceSale     @relation(fields: [advanceSaleId], references: [id])
  advanceSaleRuleId String
  advanceSaleRule   AdvanceSaleRule @relation(fields: [advanceSaleRuleId], references: [id])

  advanceSaleName String
  discountPercent Int
  discountAmount  Decimal @db.Decimal(10, 2)
  ticketsApplied  Int

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advanceSaleId])
  @@index([advanceSaleRuleId])
}

model OrderItemStatusHistory {
  id                      String         @id @default(uuid())
  orderItemId             String
  orderItem               OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  movementType            OrderStatus
  oldTripSeatId           String?
  oldBasePrice            Decimal?       @db.Decimal(10, 2)
  oldTax                  Decimal?       @db.Decimal(10, 2)
  oldDiscount             Decimal?       @db.Decimal(10, 2)
  oldTotalPrice           Decimal?       @db.Decimal(10, 2)
  oldStatus               TicketStatus?
  oldTripId               String?
  oldDeparture            DateTime?
  oldArrival              DateTime?
  oldRouteId              String?
  oldRouteNumber          String?
  oldOriginId             String?
  oldOriginName           String?
  oldOriginShortName      String?
  oldDestinationId        String?
  oldDestinationName      String?
  oldDestinationShortName String?
  oldSeatNumber           Int?
  oldServiceShortName     String?
  oldServiceId            String?
  oldCompanyId            String?
  oldPaymentMethod        PaymentMethod?
  oldTripSegmentId        String?
  oldTripSegment          TripSegment?   @relation(fields: [oldTripSegmentId], references: [id])
  surchargeOrderId        String?
  surcharge               Order?         @relation("TicketMovementSurcharge", fields: [surchargeOrderId], references: [id])
  refundOrderId           String?
  refund                  Order?         @relation("TicketMovementRefund", fields: [refundOrderId], references: [id])
  penaltyOrderId          String?
  penalty                 Order?         @relation("TicketMovementPenalty", fields: [penaltyOrderId], references: [id])
  reason                  String?
  changedByAdvisorId      String?
  changedByAdvisor        AdvisorUser?   @relation("StatusHistoryChangedByAdvisor", fields: [changedByAdvisorId], references: [id])
  salesChannelId          String?
  salesChannel            SalesChannel?  @relation(fields: [salesChannelId], references: [id])
  changedByClientId       String?
  changedByClient         Client?        @relation("StatusHistoryChangedByClient", fields: [changedByClientId], references: [id])

  // Campos para tracking de nuevo folio en cambios/canjes
  oldTicketNumber String?
  oldOrderItemId  String?
  newTicketNumber String?
  newOrderItemId  String?

  createdAt      DateTime           @default(now())
  advisorUser    AdvisorUser?       @relation(fields: [advisorUserId], references: [id])
  advisorUserId  String?
  clientId       String?
  client         Client?            @relation(fields: [clientId], references: [id])
  shiftId        String?
  shift          CashRegisterShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashRegisterId String?
  cashRegister   CashRegister?      @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([movementType])
  @@index([createdAt])
  @@index([oldTripId])
  @@index([shiftId])
  @@index([cashRegisterId])
}

model OrderItem {
  id            String  @id @default(uuid())
  ticketNumber  String  @unique
  ticketTraceId String? @default(dbgenerated("gen_random_uuid()"))

  basePrice  Decimal @db.Decimal(10, 2)
  tax        Decimal @default(0) @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  status                       TicketStatus    @default(PAID)
  hasPromotion                 Boolean         @default(false)
  discountSource               DiscountSource?
  passengerTypeDiscountPercent Int?
  isInvoiced                   Boolean         @default(false)
  ineId                        String?
  invoiceCode                  String?
  referenceId                  String?

  canceledAt     DateTime?
  canceledReason String?
  isRoundOpen    Boolean   @default(false)
  isOutbound     Boolean? // true = Ida, false = Regreso, null = Sencillos/Abiertos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderId             String
  order               Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tripSeatId          String?
  tripSeat            TripSeat?                @relation(fields: [tripSeatId], references: [id])
  routeId             String?
  route               Route?                   @relation(fields: [routeId], references: [id])
  segmentId           String?
  segment             Segment?                 @relation(fields: [segmentId], references: [id])
  reference           TicketReference?         @relation(fields: [referenceId], references: [id])
  passenger           Passenger?
  statusHistory       OrderStatusHistory[]     @relation("OrderItemHistory")
  movementHistory     OrderItemStatusHistory[]
  loyaltyTransactions LoyaltyTransaction[]
  agencyCharge        AgencyCharge?
  offlineRecord       OrderItemOffline?

  @@unique([tripSeatId, segmentId]) // Evita duplicados: mismo asiento + mismo segmento
  @@index([orderId])
  @@index([referenceId])
  @@index([ticketTraceId]) // Búsqueda de cadena completa en O(1)
}

/// Contador de folios por estación+minuto+canal. Una sola sentencia
/// (INSERT .. ON CONFLICT DO UPDATE .. RETURNING) reserva el lote completo sin
/// candados de aplicación; ver `@shared/utils/ticket-number.util`.
/// `prefix` = SSSS + TTTTTTTT + C (13 caracteres).
model FolioCounter {
  prefix     String @id
  lastSuffix Int
}

